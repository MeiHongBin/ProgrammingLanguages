<!-- 刪除 -->


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PasswordHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegisterDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile)
            </th>
@*             <th>
                @Html.DisplayNameFor(model => model.Us1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Us2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Us3)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PasswordHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegisterDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Profile)
            </td>
@*             <td>
                @Html.DisplayFor(modelItem => item.Us1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Us2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Us3)
            </td> *@
            <td>
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#UserEditModal">
                    編輯
                </button>
                <a asp-action="Edit" asp-route-id="@item.UserId">Edit</a> |
                @* <a asp-action="Details" asp-route-id="@item.UserId">Details</a> | *@
                @* 直接傳遞模型+id，而非單純傳送表單 *@
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="item.UserId" value="@item.UserId" />
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts {
    <script>
        function submitUserCForm()
        {
            //提交 MVC 新增表單
            document.getElementById("userCForm").submit();
        }
        function clearUserCForm()
        {
            //清空 MVC 表單
            document.getElementById("userCForm").reset();
        }
        function submitUserEForm() {
            //提交 MVC 編輯表單
            document.getElementById("userEForm").submit();
        }
        // 攔截表單提交
        document.getElementById("deleteForm").addEventListener("submit", function (event) {
            event.preventDefault(); // 阻止表單默認提交行為
            // 顯示 SweetAlert2 確認框
            Swal.fire({
                title: '確定要刪除嗎？',
                text: "刪除後將無法恢復！",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: '是的，刪除！',
                cancelButtonText: '取消'
            }).then((result) => {
                if (result.isConfirmed) {
                    // 提交表單
                    event.target.submit();
                }
            });
        });
        // 如果刪除成功，顯示成功提示
        @if (TempData["DeleteSuccess"] != null)
        {
            <text>
                Swal.fire({
                    title: '刪除成功！',
                    text: '該項目已成功刪除。',
                    icon: 'success',
                    confirmButtonText: '確定'
                });
            </text>
        }
    </script>
}


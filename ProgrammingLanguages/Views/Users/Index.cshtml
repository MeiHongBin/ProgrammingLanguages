@model IEnumerable<ProgrammingLanguages.ProgrammingLanguageModels.User>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<!-- Button trigger modal -->
<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#UserCreateModal" onclick="clearUserCForm()">
    新增
</button>

<!-- 新增使用者 -->
<div class="modal fade" id="UserCreateModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">新增使用者</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <partial name="~/Views/Users/_UserCPartial.cshtml" model="ViewBag.UserE ?? new ProgrammingLanguages.ProgrammingLanguageModels.User()" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitUserCForm()">儲存</button>
            </div>
        </div>
    </div>
</div>
<!-- 編輯 -->
<div class="modal fade" id="UserEditModal" tabindex="-1" role="dialog" aria-labelledby="EditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="EditModalLabel">編輯使用者</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="modalBodyContent">
                加载中...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary">更改密碼</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitUserEForm()">儲存</button>
            </div>
        </div>
    </div>
</div>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th hidden>
                @Html.DisplayNameFor(model => model.PasswordHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegisterDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Profile)
            </th>
@*             <th>
                @Html.DisplayNameFor(model => model.Us1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Us2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Us3)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td hidden>
                @Html.DisplayFor(modelItem => item.PasswordHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegisterDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Profile)
            </td>
@*             <td>
                @Html.DisplayFor(modelItem => item.Us1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Us2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Us3)
            </td> *@
            <td>
                @*這裡有用很神奇的方法*@
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#UserEditModal" data-userid="@item.UserId">
                    編輯
                </button>
@*                 <a asp-action="Edit" asp-route-id="@item.UserId">Edit</a> | *@
                @* 直接傳遞模型+id，而非單純傳送表單 *@
                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="item.UserId" value="@item.UserId" />
                    <input type="submit" value="Delete" class="btn btn-danger"/>
                </form>
            </td>
        </tr>
}
    </tbody>
</table>
@section Scripts {
    <script>
    @*這裡有用很神奇的方法*@
    @*使用bs自帶的功能show.bs.modal*@
    @*取得userid後執行jq的ajax請求*@
    document.addEventListener("DOMContentLoaded", function () {
        $('#UserEditModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            const userId = button.data('userid');

            //發起 AJAX 請求，載入部分視圖
            $.ajax({
                url: '/Users/Edit/'+userId, //指向後端 Action 方法
                method: 'GET',
                success: function (html) {
                    //取代網頁內容
                    $('#modalBodyContent').html(html);
                },
                error: function () {
                    $('#modalBodyContent').html('<p class="text-danger">加載失敗，請稍後再試。</p>');
                }
            });
        });
    });

        function submitUserCForm()
        {
            //提交 MVC 新增表單
            document.getElementById("userCForm").submit();
        }
        function clearUserCForm()
        {
            //清空 MVC 表單
            document.getElementById("userCForm").reset();
        }
        function submitUserEForm() {
            //提交 MVC 編輯表單
            document.getElementById("userEForm").submit();
        }
        // 如果刪除成功，顯示成功提示
        @if (TempData["DeleteSuccess"] != null)
        {
            <text>
                Swal.fire({
                    title: '刪除成功！',
                    text: '該項目已成功刪除。',
                    icon: 'success',
                    confirmButtonText: '確定'
                });
            </text>
        }
    </script>
}

